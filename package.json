{
  "name": "text-idle",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -s first -n backend,frontend \"go run ./cmd/server\" \"cd frontend && npm run dev\"",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "dev:backend": "go run ./cmd/server",
    "dev:frontend": "cd frontend && npm run dev",
    "e2e": "powershell -ExecutionPolicy Bypass -File scripts/e2e.ps1",
    "e2e:fast": "powershell -ExecutionPolicy Bypass -File scripts/e2e.ps1 -Fast",
    "e2e:run": "powershell -ExecutionPolicy Bypass -File scripts/e2e.ps1",
    "e2e:run:fast": "powershell -ExecutionPolicy Bypass -File scripts/e2e.ps1 -Fast",
    "e2e:headed": "npx playwright test --config=e2e/browser/playwright.config.js --headed",
    "build:combat-bundle": "node scripts/build-combat-bundle.mjs",
    "build:dist": "powershell -ExecutionPolicy Bypass -File scripts/build-dist.ps1",
    "package:dist": "powershell -ExecutionPolicy Bypass -File scripts/package-dist.ps1",
    "deploy:tencent": "powershell -ExecutionPolicy Bypass -File scripts/deploy-tencent.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.1",
    "wait-on": "^8.0.1"
  }
}
